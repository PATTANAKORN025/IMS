# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# IMS Git Ignore
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Secrets (NEVER commit)
secrets/
.env
*.key
*.pem

# Real production data (NEVER commit) — schema/views/functions/dashboards
# are the only things this repo tracks; real LDI data lives here locally
# only, loaded via scripts/import-real-data.sh. See docs/REAL-DATA-IMPORT.md.
data/real/

# Docker named-volume / local data dirs
*_data/

# Continuous observability archive (docker events + crash-log tails) --
# durable evidence lives here at runtime, not meant to be committed; see
# scripts/observability-archiver.sh and container_restart_audit table.
ops-logs/

# AI tooling / test artifacts — not project source
.gemini/
.claude/
.mimocode/
.playwright-mcp/
.ai/
.opencode/
.mcp.json
AGENTS.md
MEMORY.md
checkpoint.md

# IDE
.vs/
# VS Code cache in node_modules
node_modules/.vs/
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temp scripts (auto-generated)
_tmp_*.js
_tmp_*.sql
scratch_scripts/_tmp_*.py

# K6 results
tests/k6/*-results.json

# node_modules everywhere
**/node_modules/

# ── Node-RED data dir ─────────────────────────────────────
!nodered_data/
nodered_data/*
!nodered_data/settings.js
!nodered_data/package.json
!nodered_data/Dockerfile
!nodered_data/settings-prometheus.js
!nodered_data/flows/
nodered_data/flows/*
!nodered_data/flows/ingestion.json
!nodered_data/flows/alerting.json
!nodered_data/flows/ldi_ingestion.json
!nodered_data/flows/ldi_simulator.json
!nodered_data/flows/ldi_alarm_simulator.json
!nodered_data/lib/

# Backups (created by scripts/backup-db.sh)
backups/

# Playwright screenshot output (generated by make test-visual / test-visual-ldi)
tests/playwright/screenshots/

# Workspace artifacts (AI tooling, not project source)
ABOUT-ME.md
ARCHIVES/
CONTEXT.md
GLOBAL-INSTRUCTIONS.md
INPUTS/
OUTPUTS/
PROJECT-README.md
SKILLS/
START.md
TASKS.md
TEMPLATES/
dashboard.html
memory/
backup_*.sql

docker-compose.override.yaml

# Runtime output from scripts/soak-test-report.sh -- generated during a
# soak run, not committable source.
scripts/soak-test-reports/
scripts/dr-test-reports/

# Per-run raw evidence from tests/*/runner.js (Production Assurance
# Framework) -- regenerable, grows with every local run. The aggregated
# report/rendered docs (PRODUCTION-READINESS.md, FAILURE_DETECTION_MATRIX.md)
# are what's committed as durable evidence, same pattern as the two lines above.
docs/evidence/runtime/

# Scratch Node-RED /data dir generated per-run by tests/fleet/runner.js for
# the disposable P9 fleet-ingestion stack (copied from nodered_data/,
# regenerated every run -- not source).
tests/fleet/.runtime/

# Editor/script backup and scratch dumps that turn up locally but were
# never meant to be committed source.
*.bak
scratch_sql.txt

# Scratch directories for temporary Agent runs
.p11-scratch/
.p11c-scratch/
p*_scratch/

# Allow tracking agent skills
!.agents/skills/
