    {
      "id": 4,
      "title": "◈ Machine Run State",
      "type": "state-timeline",
      "datasource": {
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "#FF003C",
                  "index": 0,
                  "text": "NO_DATA"
                },
                "1": {
                  "color": "#FF9100",
                  "index": 1,
                  "text": "IDLE"
                },
                "2": {
                  "color": "#00F2FE",
                  "index": 2,
                  "text": "OK"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#FF003C",
                "value": null
              },
              {
                "color": "#facc15",
                "value": 1
              },
              {
                "color": "#22c55e",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 100
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "alignValue": "center",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "WITH machines AS (\n  SELECT device_id AS eqp_id FROM public.devices WHERE device_type='ldi' AND enabled AND device_id IN (${machine_id:sqlstring})\n),\nbuckets AS (\n  SELECT generate_series(time_bucket('5 minutes', $__timeFrom()), time_bucket('5 minutes', $__timeTo()), INTERVAL '5 minutes') AS bucket_time\n),\ngrid AS (\n  SELECT m.eqp_id, b.bucket_time FROM machines m CROSS JOIN buckets b\n),\nactual AS (\n  SELECT eqp_id, time_bucket('5 minutes', time) AS bucket_time, BOOL_OR(state) AS any_running, COUNT(*) AS n\n  FROM public.ldi_data\n  WHERE $__timeFilter(time) AND factory IN (${factory:sqlstring}) AND mo IN (${mo:sqlstring})\n  GROUP BY 1, 2\n)\nSELECT g.bucket_time AS time, g.eqp_id AS metric,\n  CASE WHEN a.n IS NULL OR a.n = 0 THEN 0\n       WHEN a.any_running THEN 2\n       ELSE 1 END AS value\nFROM grid g LEFT JOIN actual a ON a.eqp_id = g.eqp_id AND a.bucket_time = g.bucket_time\nORDER BY g.bucket_time ASC",
          "format": "time_series",
          "legendFormat": "{{metric}}"
        }
      ],
      "description": "Per-machine state on a 5-minute grid (5min chosen because the slowest-reporting machine's average gap is ~3.7min -- 1-minute buckets would falsely flag healthy-but-infrequent machines as NO_DATA). OK = reporting and running; IDLE = reporting but state=false (not currently producing); NO_DATA = zero rows in that 5-minute window for this machine -- a real gap in the pipeline, not just \"stopped\", and now visually distinct from OK/IDLE instead of silently blank."
    },
