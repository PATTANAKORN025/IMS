          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "SELECT DISTINCT ON (eqp_id) eqp_id AS metric, ROUND((GREATEST(ABS(pe_1),ABS(pe_2),ABS(pe_3),ABS(pe_4),ABS(pe_5),ABS(pe_6)) * 100.0 / NULLIF(pe_setting,0))::NUMERIC, 0) AS value FROM public.ldi_data WHERE factory IN (${factory:sqlstring}) AND mo IN (${mo:sqlstring}) AND eqp_id IN (${machine_id:sqlstring}) AND $__timeFilter(time) AND pe_1 IS NOT NULL AND pe_setting > 0 ORDER BY eqp_id, time DESC",
          "format": "table"
        }
      ],
      "description": "Latest MAX|PE| as % of each machine's spec limit (pe_setting). Green <80%, Amber 80-100%, Red >=100% (out of spec). Glanceable spec-proximity indicator; no line graph per ISA-101 kiosk guidance."
