                  "text": "NO_DATA",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 56,
          "titleSize": 16
        },
        "noValue": "NO_DATA",
        "textMode": "auto",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "/* QUERY_BUDGET_EXEMPT-safe rewrite (World-Class QA, 2026-08-06): same\n   DISTINCT-ON-vs-compressed-chunks fix as the \"Machines Running\" panel --\n   see that panel's comment. */\nWITH machines AS (\n  SELECT device_id AS eqp_id FROM public.devices WHERE device_type='ldi' AND enabled AND device_id IN (${machine_id:sqlstring})\n)\nSELECT ROUND((COUNT(*) FILTER (WHERE l.state = true) * 100.0 / NULLIF(COUNT(*), 0))::NUMERIC, 0) AS value\nFROM machines m\nLEFT JOIN LATERAL (\n  SELECT state FROM public.ldi_data d\n  WHERE d.eqp_id = m.eqp_id AND $__timeFilter(d.time) AND d.factory IN (${factory:sqlstring}) AND d.mo IN (${mo:sqlstring})\n  ORDER BY d.time DESC LIMIT 1\n) l ON true",
          "format": "table"
        }
      ],
      "description": "Percent of the SELECTED registered+enabled LDI fleet (machine_id filter) currently OK (reporting AND running). Denominator is always the full selected machine registry, not just machines that happened to report -- a machine that goes completely silent now correctly drags this down instead of silently disappearing from both sides of the ratio."
    },
