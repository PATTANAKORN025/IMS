          },
          "rawSql": "SELECT CASE WHEN n IS NULL OR n = 0 THEN 0 WHEN any_running THEN 2 ELSE 1 END AS \"$machine_id\"\nFROM (\n  SELECT BOOL_OR(state) AS any_running, COUNT(*) AS n\n  FROM public.ldi_data\n  WHERE eqp_id = ${machine_id:sqlstring} AND time > NOW() - INTERVAL '10 minutes'\n) x",
          "format": "table"
        }
      ],
      "description": "Live OK/IDLE/NO_DATA status for $machine_id. Repeats per the machine_id variable (whichever eqp_id values actually have rows in ldi_data), so this works unmodified in both real and mock data mode."
