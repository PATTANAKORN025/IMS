      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "WITH machines AS (\n  SELECT device_id AS eqp_id FROM public.devices WHERE device_type='ldi' AND enabled AND device_id IN (${machine_id:sqlstring})\n),\nlatest AS (\n  SELECT DISTINCT ON (eqp_id) eqp_id, state\n  FROM public.ldi_data\n  WHERE $__timeFilter(time) AND factory IN (${factory:sqlstring}) AND mo IN (${mo:sqlstring})\n  ORDER BY eqp_id, time DESC\n)\nSELECT COUNT(*) FILTER (WHERE l.state = true) AS value\nFROM machines m LEFT JOIN latest l ON l.eqp_id = m.eqp_id",
          "format": "table"
        }
