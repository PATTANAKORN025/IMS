          "unit": "percent",
          "custom": {
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "decimals": 0,
          "min": 0,
          "max": 100,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
