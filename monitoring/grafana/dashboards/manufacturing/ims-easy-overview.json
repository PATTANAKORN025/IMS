      "panels": [
        {
          "id": 5,
          "title": "◈ Machine Status",
          "type": "table",
          "datasource": {
            "uid": "timescaledb"
          },
          "gridPos": {
            "x": 0,
            "y": 0,
            "w": 24,
            "h": 8
          },
          "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "footer": {
              "show": false
            },
            "sortBy": []
          },
          "fieldConfig": {
            "defaults": {
              "custom": {}
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "uid": "timescaledb"
              },
              "rawSql": "SELECT eqp_id AS \"Machine\", CASE WHEN state THEN 'RUNNING' ELSE 'IDLE' END AS \"State\",\n       mo AS \"Job (MO)\", fpn AS \"Part (FPN)\", layer_name AS \"Layer\",\n       CASE WHEN log_id IS NULL THEN 'NO_DATA' ELSE (board_no::TEXT || '/' || total_board::TEXT) END AS \"Progress\",\n       ROUND(temperature::NUMERIC, 1) AS \"Temp (°C)\", ROUND(humidity::NUMERIC, 1) AS \"Humidity (%RH)\",\n       ROUND(thickness::NUMERIC, 3) AS \"Thickness (mm)\",\n       CASE WHEN is_stale THEN 'STALE (>5min)' ELSE 'live' END AS \"Freshness\"\nFROM public.v_ldi_machine_latest_full\nORDER BY eqp_id",
              "format": "table"
            }
          ],
          "description": "One row per registered machine, always -- straight from public.v_ldi_machine_latest_full (migration 052). No filters to set up."
        }
      ]
    },
