    {
      "id": 3,
      "title": "◉ Estimated Yield (1h)",
      "type": "stat",
      "datasource": {
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#EF4444",
                "value": null
              },
              {
                "color": "#F59E0B",
                "value": 80
              },
              {
                "color": "#22C55E",
                "value": 95
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "#64748B",
                  "text": "NO_DATA",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "noValue": "NO_DATA",
        "textMode": "value",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "text": {
          "valueSize": 56,
          "titleSize": 18
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "/* QUERY_BUDGET_EXEMPT-safe rewrite (System QA, 2026-08-06): calling public.f_ldi_yield_pct() here defeated TimescaleDB chunk exclusion once compress_after started compressing older chunks -- EXPLAIN ANALYZE showed ~115ms / 13000+ buffers touched (scanning every chunk) for the function-call form vs ~2ms / 58 buffers for the identical logic inlined directly. Same formula as f_ldi_yield_pct() (migration 046), just inlined so the time bound is visible to the planner at plan time. */\nSELECT COALESCE(\n      LEAST(\n          ROUND(100.0 * COUNT(*) FILTER (WHERE GREATEST(ABS(pe_1),ABS(pe_2),ABS(pe_3),ABS(pe_4),ABS(pe_5),ABS(pe_6)) <= pe_setting) / NULLIF(COUNT(*) FILTER (WHERE pe_1 IS NOT NULL),0)::NUMERIC, 1),\n          ROUND(100.0 * COUNT(*) FILTER (WHERE GREATEST(ABS(je_1),ABS(je_2),ABS(je_3),ABS(je_4)) <= je_setting) / NULLIF(COUNT(*) FILTER (WHERE je_1 IS NOT NULL),0)::NUMERIC, 1)\n      ),\n      ROUND(100.0 * COUNT(*) FILTER (WHERE GREATEST(ABS(pe_1),ABS(pe_2),ABS(pe_3),ABS(pe_4),ABS(pe_5),ABS(pe_6)) <= pe_setting) / NULLIF(COUNT(*) FILTER (WHERE pe_1 IS NOT NULL),0)::NUMERIC, 1),\n      ROUND(100.0 * COUNT(*) FILTER (WHERE GREATEST(ABS(je_1),ABS(je_2),ABS(je_3),ABS(je_4)) <= je_setting) / NULLIF(COUNT(*) FILTER (WHERE je_1 IS NOT NULL),0)::NUMERIC, 1)\n  ) AS value\nFROM public.ldi_data\nWHERE \"time\" BETWEEN NOW() - INTERVAL '1 hour' AND NOW()",
          "format": "table"
        }
      ],
      "description": "Fleet-wide PE/JE yield over the last hour. Inlined copy of public.f_ldi_yield_pct()'s formula (migration 046) -- calling the function directly defeated chunk exclusion against compressed chunks (System QA, 2026-08-06), so this panel computes it inline instead. Keep in sync with the function if the formula ever changes."
    },
    {
      "id": 4,
      "title": "◉ Critical Alarms (1h)",
      "type": "stat",
      "datasource": {
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22C55E",
                "value": null
              },
              {
                "color": "#F59E0B",
                "value": 1
              },
              {
                "color": "#EF4444",
                "value": 20
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "#64748B",
                  "text": "NO_DATA",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "noValue": "NO_DATA",
        "textMode": "value",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "text": {
          "valueSize": 56,
          "titleSize": 18
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "SELECT COUNT(*)::NUMERIC AS value\nFROM public.ldi_alarm_log a\nJOIN public.ldi_alarm_ms_code m ON a.errorcode::TEXT = m.alarm_code::TEXT\nWHERE a.logdate > NOW() - INTERVAL '1 hour' AND m.severity IN ('Critical', 'Major');",
          "format": "table"
        }
      ],
      "description": "Alarms in the last hour whose master code (public.ldi_alarm_ms_code.alarm_type) is 'A' (Alarm-class, the more severe of the 2 real values -- the other is 'W' for Warning). Query Optimization pass: the original ILIKE '%Critical%' filter never matched anything since the real column only ever holds single-letter codes, so this KPI silently showed 0 regardless of real critical activity across 3 dashboards -- confirmed live (14 real 'A' alarms in the prior hour, vs. 0 reported)."
    },
    {
      "id": 9001,
      "type": "row",
      "title": "◈ PER-MACHINE STATUS",
      "gridPos": {
        "x": 0,
