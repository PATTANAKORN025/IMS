            ]
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "uid": "timescaledb"
              },
              "rawSql": "/* RESOLVED 2026-08-10 (migration 064): v_machine_spc_fleet is now a materialized view refreshed every 60s via a TimescaleDB background job, not recomputed per read (comment above was stale -- corrected alongside the Confidence-column consistency fix). */\nSELECT eqp_id AS \"Machine\", n_pe AS \"PE Samples\", cpk_pe AS \"Cpk (PE)\", pe_pass_rate AS \"PE Pass %\",\n       n_je AS \"JE Samples\", cpk_je AS \"Cpk (JE)\", je_pass_rate AS \"JE Pass %\", worst_cpk AS \"Worst Cpk\",\n       CASE\n         WHEN worst_cpk IS NULL THEN 'NO_DATA'\n         WHEN COALESCE(CASE WHEN cpk_pe IS NULL THEN n_je WHEN cpk_je IS NULL THEN n_pe WHEN cpk_pe <= cpk_je THEN n_pe ELSE n_je END, 0) < 30 THEN 'LOW SAMPLE (n<30)'\n         ELSE 'OK'\n       END AS \"Confidence\"\nFROM public.v_machine_spc_fleet\nORDER BY worst_cpk ASC NULLS LAST",
              "format": "table"
            }
          ],
          "description": "24h rolling process capability per machine, from public.v_machine_spc_fleet (migrations 041/042). Sorted worst-first so the machine needing attention is always at the top."
        }
