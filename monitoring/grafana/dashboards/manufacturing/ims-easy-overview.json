            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Alarm Event ID"
                },
                "properties": [
                  {
                    "id": "description",
                    "value": "Unique ID for this exact alarm occurrence (ldi_alarm_log.logid). Not the alarm type -- the same Alarm Code fires repeatedly; this ID identifies which specific firing this row is."
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "Alarm Code"
                },
                "properties": [
                  {
                    "id": "description",
                    "value": "The alarm type/definition code from the vendor Alarm Master catalog (ldi_alarm_ms_code). Shared by every occurrence of this alarm type. Click to open the Alarm Dictionary."
                  },
                  {
                    "id": "links",
                    "value": [
                      {
                        "title": "Open Alarm Dictionary",
                        "url": "/d/ims-ldi-alarm-dictionary/alarm-dictionary?var-alarm_code=${__value.text}",
                        "targetBlank": false
                      }
                    ]
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "Telemetry Event ID"
                },
                "properties": [
                  {
                    "id": "description",
                    "value": "The linked telemetry snapshot (ldi_data.log_id). See 'Match': exact = confirmed by direct log_id join; nearest = inferred by closest timestamp, not a confirmed link."
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "Severity"
                },
                "properties": [
                  {
                    "id": "mappings",
                    "value": [
                      {
                        "type": "value",
                        "options": {
                          "Critical": {
                            "color": "#EF4444",
                            "index": 0,
                            "text": "Critical"
                          },
                          "Major": {
                            "color": "#F59E0B",
                            "index": 1,
                            "text": "Major"
                          },
                          "Minor": {
                            "color": "#EAB308",
                            "index": 2,
                            "text": "Minor"
                          },
                          "Warning": {
                            "color": "#3B82F6",
                            "index": 3,
                            "text": "Warning"
                          },
                          "UNMAPPED": {
                            "color": "#64748B",
                            "index": 4,
                            "text": "UNMAPPED"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "id": "custom.cellOptions",
                    "value": {
                      "type": "color-background"
                    }
                  },
                  {
                    "id": "custom.displayMode",
                    "value": "color-background"
                  }
                ]
              }
            ]
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "uid": "timescaledb"
              },
              "rawSql": "SELECT alarm_time AS \"Time\", eqp_id AS \"Machine\", alarm_id AS \"Alarm Event ID\", errorcode AS \"Alarm Code\", alarm_msg AS \"Message\", alarm_detail AS \"Detail\",\n       COALESCE(severity, 'UNMAPPED') AS \"Severity\",\n       ROUND(temperature::NUMERIC, 1) AS \"Temp (°C)\", ROUND(humidity::NUMERIC, 1) AS \"Humidity (%RH)\",\n       related_log_id AS \"Telemetry Event ID\", COALESCE(match_type, 'none') AS \"Match\"\nFROM public.v_ldi_alarm_context\nORDER BY alarm_time DESC LIMIT 50",
              "format": "table"
            }
          ],
          "description": "Last 50 alarms fleet-wide, straight from public.v_ldi_alarm_context (migration 053, exact-event-linked). \"Match\" shows exact (authored by the machine at write-time) vs nearest (inferred)."
        }
      ]
    },
