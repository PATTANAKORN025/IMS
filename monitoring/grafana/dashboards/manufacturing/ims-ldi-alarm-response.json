    {
      "id": 5,
      "title": "◈ Daily MTTA / MTTR Trend",
      "description": "Daily-bucketed mean acknowledge/resolve time over the selected range. Will render empty until real Acknowledge/Resolve activity accumulates -- not an error state.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 day', logdate) AS time,\n  ROUND((EXTRACT(EPOCH FROM AVG(acknowledged_at - logdate)) / 60)::NUMERIC, 1) AS \"MTTA (min)\"\nFROM public.ldi_alarm_lifecycle\nWHERE acknowledged_at IS NOT NULL\n  AND $__timeFilter(logdate)\nGROUP BY 1\nORDER BY 1;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 day', logdate) AS time,\n  ROUND((EXTRACT(EPOCH FROM AVG(resolved_at - logdate)) / 60)::NUMERIC, 1) AS \"MTTR (min)\"\nFROM public.ldi_alarm_lifecycle\nWHERE resolved_at IS NOT NULL\n  AND $__timeFilter(logdate)\nGROUP BY 1\nORDER BY 1;",
          "refId": "B",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
