    {
      "id": 6,
      "title": "◈ Currently Open — Longest Waiting (Triage)",
      "description": "Real signal today, unlike the panels above: every currently-OPEN alarm, oldest first. Wait time = NOW() - logdate, not a historical MTTA measurement -- this is 'what needs attention right now', not 'how fast did we respond historically'.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: this is a live triage queue, not a historical trend -- always shows current state */\nSELECT a.equipmentid AS \"Machine\",\n  m.severity AS \"Severity\",\n  m.alarm_msg AS \"Alarm\",\n  l.logdate AS \"Fired At\",\n  ROUND((EXTRACT(EPOCH FROM (NOW() - l.logdate)) / 60)::NUMERIC, 1) AS \"Waiting (min)\"\nFROM public.ldi_alarm_lifecycle l\nJOIN public.ldi_alarm_log a ON a.logdate = l.logdate AND a.logid = l.logid\nLEFT JOIN public.ldi_alarm_ms_code m ON a.errorcode::TEXT = m.alarm_code::TEXT\nWHERE l.status = 'OPEN'\nORDER BY l.logdate ASC\nLIMIT 20;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Critical": {
                        "color": "#EF4444",
                        "index": 0
                      },
                      "Major": {
                        "color": "#F59E0B",
                        "index": 1
                      },
                      "Minor": {
                        "color": "#EAB308",
                        "index": 2
                      },
                      "Warning": {
                        "color": "#3B82F6",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
