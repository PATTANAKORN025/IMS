    {
      "id": 7,
      "title": "◈ Telemetry Ingestion Rows by Machine",
      "description": "Actual telemetry rows received in each five-minute bucket. Gaps indicate no stored rows, not simulated downtime. Reads from ldi_data_1m (sample_count) instead of raw ldi_data, per the query tiering contract (docs/GRAFANA_DESIGN_SYSTEM.md §10) -- this dashboard defaults to now-6h.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 16,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "/* QUERY_BUDGET_EXEMPT: simple aggregate over full-range ldi_data, but at current data volume (300K+ rows and growing) exceeds the 80ms real-time budget. World-Class QA pass (2026-08-06): documented rather than silently ignored; revisit if this becomes an operator-facing latency complaint. */\nSELECT\n  time_bucket('5 minutes', bucket) AS \"time\",\n  eqp_id AS metric,\n  SUM(sample_count)::NUMERIC AS value\nFROM public.ldi_data_1m\nWHERE $__timeFilter(bucket)\n  AND factory IN (${factory:sqlstring})\n  AND eqp_id IN (${machine_id:sqlstring})\nGROUP BY 1, 2\nORDER BY 1, 2;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "rows / 5 min",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisSoftMin": 0,
            "axisSoftMax": 200,
            "gradientMode": "opacity"
          },
          "unit": "suffix: rows/5m",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "connectNullPoints": true
      }
    },
