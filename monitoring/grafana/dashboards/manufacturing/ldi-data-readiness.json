    {
      "id": 13,
      "title": "◉ Alarm Lifecycle Coverage",
      "description": "Percent of alarms fired since the lifecycle feature (migration 077) went live that actually have a public.ldi_alarm_lifecycle row. Alarms from before that date correctly have none (no fabricated backfill) and are excluded from this check, not counted against it. Below 100% here means the auto-init trigger (trg_ldi_alarm_lifecycle_init) is not firing for some inserts -- a real bug, not a historical-data gap.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 10,
        "w": 4,
        "x": 0,
        "y": 61
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: full dataset scope, self-bounded by migration cutoff below */\nWITH cutoff AS (\n  SELECT applied_at FROM public.schema_migrations WHERE version = '077-ldi-alarm-lifecycle'\n)\nSELECT ROUND((100.0 * COUNT(*) FILTER (\n  WHERE EXISTS (SELECT 1 FROM public.ldi_alarm_lifecycle l WHERE l.logdate = a.logdate AND l.logid = a.logid)\n) / NULLIF(COUNT(*), 0))::NUMERIC, 1) AS value\nFROM public.ldi_alarm_log a, cutoff c\nWHERE a.equipmentid IN (${machine_id:sqlstring})\n  AND a.logdate >= c.applied_at;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
