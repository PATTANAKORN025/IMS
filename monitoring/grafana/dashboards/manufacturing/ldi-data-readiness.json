          "rawSql": "SELECT COUNT(*)::NUMERIC AS value\nFROM public.ldi_alarm_lifecycle l\nJOIN public.ldi_alarm_log a ON a.logdate = l.logdate AND a.logid = l.logid\nWHERE a.equipmentid IN (${machine_id:sqlstring})\n  AND l.status = 'ACKNOWLEDGED'\n  AND l.acknowledged_at < NOW() - INTERVAL '2 hours';",
