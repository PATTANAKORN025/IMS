    {
      "id": 1,
      "title": "◉ Telemetry Age",
      "description": "Hours since the latest real telemetry row. Green is under 1 hour; red is over 24 hours.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 10,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Intentional full table scan for global readiness\nSELECT ROUND((EXTRACT(EPOCH FROM (NOW() - MAX(\"time\"))) / 3600.0)::NUMERIC, 1) AS value\nFROM public.ldi_data\nWHERE factory IN (${factory:sqlstring})\n  AND eqp_id IN (${machine_id:sqlstring});",
