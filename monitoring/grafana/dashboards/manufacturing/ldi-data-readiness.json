          "format": "table",
          "rawQuery": true,
          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: full dataset scope */\n-- Intentional full table scan for global readiness\nWITH alarm_counts AS (\n  SELECT equipmentid AS eqp_id, COUNT(*) AS alarm_rows, MAX(logdate) AS last_alarm\n  FROM public.ldi_alarm_log\n  GROUP BY equipmentid\n)\nSELECT\n  d.eqp_id AS \"Machine\",\n  MIN(d.factory) AS \"Factory\",\n  MIN(d.process) AS \"Process\",\n  COUNT(*) AS \"Telemetry Rows\",\n  MAX(d.\"time\") AS \"Latest Telemetry\",\n  ROUND((100.0 * COUNT(d.pe_1) / COUNT(*))::NUMERIC, 1) AS \"PE %\",\n  ROUND((100.0 * COUNT(d.je_1) / COUNT(*))::NUMERIC, 1) AS \"JE1-3 %\",\n  ROUND((100.0 * COUNT(d.je_4) / COUNT(*))::NUMERIC, 1) AS \"JE4 %\",\n  COALESCE(MAX(a.alarm_rows), 0) AS \"Alarm Rows\",\n  MAX(a.last_alarm) AS \"Latest Alarm\"\nFROM public.ldi_data d\nLEFT JOIN alarm_counts a ON a.eqp_id = d.eqp_id\nWHERE d.factory IN (${factory:sqlstring})\n  AND d.eqp_id IN (${machine_id:sqlstring})\nGROUP BY d.eqp_id\nORDER BY d.eqp_id\nLIMIT 1000;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
