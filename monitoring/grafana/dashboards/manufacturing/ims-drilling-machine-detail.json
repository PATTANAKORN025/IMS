          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: latest observed program load. */\nSELECT event_time AS \"Loaded At\", event_code AS \"Code\", event_message AS \"Program Evidence\"\nFROM public.machine_event WHERE equipment_id=${focus_machine:sqlstring} AND event_type='PROGRAM_LOAD'\nORDER BY event_time DESC, id DESC LIMIT 1",
