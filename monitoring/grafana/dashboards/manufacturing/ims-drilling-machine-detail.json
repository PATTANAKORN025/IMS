      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false,
        "percentChangeColorMode": "standard",
        "noValue": "NO_DATA"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: latest known status. */\nSELECT CASE WHEN event_type='RUN' THEN 4 WHEN event_type='STOP' THEN 3 ELSE 5 END AS \"State\"\nFROM public.machine_event WHERE equipment_id=${focus_machine:sqlstring} AND message_type='status'\nORDER BY event_time DESC, id DESC LIMIT 1",
          "format": "table"
        }
      ]
    },
