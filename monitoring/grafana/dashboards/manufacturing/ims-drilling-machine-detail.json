      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: historical error reference, not active lifecycle. */\nWITH latest AS (\n  SELECT *, NULLIF(regexp_replace(event_code,'[^0-9]','','g'),'')::INTEGER AS code_num\n  FROM public.machine_event WHERE equipment_id=${focus_machine:sqlstring} AND message_type='alarm' AND level='E'\n  ORDER BY event_time DESC, id DESC LIMIT 1\n)\nSELECT event_time AS \"When\", CASE WHEN event_code ~ '^[0-9]{4}$' THEN 'E'||event_code ELSE event_code END AS \"Code\",\n  CASE WHEN code_num BETWEEN 101 AND 121 OR code_num=701 THEN 'Safety / interlock'\n       WHEN code_num BETWEEN 202 AND 324 OR code_num BETWEEN 601 AND 605 THEN 'Axis / motion'\n       WHEN code_num BETWEEN 403 AND 419 THEN 'Spindle / tool'\n       WHEN code_num BETWEEN 501 AND 519 THEN 'Program / tool table' ELSE 'Unclassified' END AS \"Category\",\n  CASE WHEN code_num BETWEEN 101 AND 121 OR code_num=701 THEN 'Startup / safety check'\n       WHEN code_num BETWEEN 202 AND 324 THEN 'Home / axis motion'\n       WHEN code_num BETWEEN 403 AND 419 THEN 'Tool change / measurement'\n       WHEN code_num BETWEEN 501 AND 519 THEN 'Program selection / validation'\n       WHEN code_num BETWEEN 601 AND 605 THEN 'Drilling setup / depth' ELSE 'Unknown phase' END AS \"Likely Phase\",\n  event_message AS \"Observed Message\", troubleshooting_method AS \"Troubleshooting\"\nFROM latest",
          "format": "table"
        }
      ]
    },
