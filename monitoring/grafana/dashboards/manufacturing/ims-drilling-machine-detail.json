      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: latest Run Hits evidence. */\nSELECT (regexp_match(event_message,'Run Hits\\s*:\\s*([0-9]+)','i'))[1]::DOUBLE PRECISION AS \"Run Hits\"\nFROM public.machine_event\nWHERE equipment_id=${focus_machine:sqlstring} AND message_type='status' AND event_message ~* 'Run Hits\\s*:'\nORDER BY event_time DESC, id DESC LIMIT 1",
          "format": "table"
        }
