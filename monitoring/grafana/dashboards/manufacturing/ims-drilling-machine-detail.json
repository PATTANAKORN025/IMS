      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: latest decoded tool-diameter evidence. */\nWITH latest AS (\n  SELECT event_time, regexp_match(event_message,'^T([0-9]+)\\s+tool diameter:\\s*([0-9.]+)\\s+([0-9.]+)\\s+([0-9.]+)\\s+([0-9.]+)\\s+([0-9.]+)\\s+([0-9.]+)','i') AS m\n  FROM public.machine_event WHERE equipment_id=${focus_machine:sqlstring} AND event_code='0215'\n  ORDER BY event_time DESC, id DESC LIMIT 1\n)\nSELECT event_time AS \"Measured At\", m[1] AS \"Tool\", u.ordinality AS \"Spindle\", ROUND(u.diameter::NUMERIC,3) AS \"Diameter\"\nFROM latest CROSS JOIN LATERAL unnest(m[2:7]) WITH ORDINALITY AS u(diameter,ordinality)\nORDER BY u.ordinality",
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "title": "LATEST DECODED ERROR — HISTORICAL",
      "type": "table",
      "datasource": {
        "type": "postgres",
