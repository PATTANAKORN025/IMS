    {
      "id": 3,
      "title": "CURRENT STATE",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "description": "Latest known operational state.",
      "fieldConfig": {
        "defaults": {
          "noValue": "NO_DATA",
          "color": {
            "mode": "fixed",
            "fixedColor": "#00F2FE"
          },
          "thresholds": {
