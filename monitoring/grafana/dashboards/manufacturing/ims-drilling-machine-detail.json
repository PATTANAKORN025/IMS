            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: source timestamp. */\nSELECT (EXTRACT(EPOCH FROM event_time)*1000)::DOUBLE PRECISION AS \"Source Time\"\nFROM public.machine_event WHERE equipment_id=${focus_machine:sqlstring} AND message_type='status'\nORDER BY event_time DESC, id DESC LIMIT 1",
          "format": "table"
