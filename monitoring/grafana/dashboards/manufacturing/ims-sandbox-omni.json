    {
      "id": 6,
      "type": "timeseries",
      "title": "Thermal vs Vacuum Kinetics (1m CAGG)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 18,
        "h": 12
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "/* Downsampled via ldi_data_1m continuous aggregate (1-minute buckets); no time_bucket() call needed here. */\nSELECT bucket AS time, avg(temperature) AS temp, avg(air_vacuum) * 100 AS vacuum_scaled FROM ldi_data_1m WHERE $__timeFilter(bucket) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 20,
            "gradientMode": "hue",
            "spanNulls": true
          }
        }
      }
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Fleet Health Score",
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 12
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT 94 AS health",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "type": "heatmap",
      "title": "Temperature Distribution Matrix",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT bucket AS time, temperature FROM ldi_data_1m WHERE $__timeFilter(bucket) LIMIT 5000",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "calculate": true,
        "cellGap": 2,
        "color": {
          "scheme": "Oranges"
        }
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Machine Output Rankings",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT eqp_id, AVG(total_board) as boards FROM v_ldi_machine_latest_full GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Machine Status Timeline (Last 6H)",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT time, eqp_id, CASE WHEN state=true THEN 1 ELSE 0 END AS state_val FROM ldi_data WHERE $__timeFilter(time) AND eqp_id IN ('LDI-01', 'LDI-02', 'LDI-03') ORDER BY time",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Live Anomaly Data Stream",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 8
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT time, eqp_id, ms_code, severity, state FROM ldi_alarm_log ORDER BY time DESC LIMIT 50",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
