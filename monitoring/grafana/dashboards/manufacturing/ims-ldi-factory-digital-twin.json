      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "timescaledb" },
          "format": "table",
          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: always the true latest row for this one hardcoded machine -- same latest-value shape and same ALARM/OK/IDLE/NO_DATA CASE logic as ims-ldi-operator-andon.json panel id 1000, copied verbatim. Node 1 = LDI-01 (fixed literal, not templated -- Canvas has no repeat mechanism, this dashboard has fixed node positions per the Task 2 POC brief). */\nSELECT\n  v.eqp_id AS eqp_id_1,\n  CASE\n    WHEN EXISTS (\n      SELECT 1 FROM public.ldi_alarm_log a\n      JOIN public.ldi_alarm_ms_code m ON a.errorcode::TEXT = m.alarm_code::TEXT\n      WHERE a.equipmentid = v.eqp_id AND m.severity IN ('Critical', 'Major')\n        AND a.logdate > NOW() - INTERVAL '5 minutes'\n    ) THEN 3\n    WHEN NOT v.has_data OR v.is_stale THEN 0\n    WHEN v.state THEN 2\n    ELSE 1\n  END AS state_1,\n  v.board_no AS board_1,\n  v.total_board AS total_board_1\nFROM public.v_ldi_machine_latest_full v\nWHERE v.eqp_id = 'LDI-01'\nLIMIT 1"
        },
        {
          "refId": "B",
          "datasource": { "uid": "timescaledb" },
          "format": "table",
          "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: always the true latest row for this one hardcoded machine -- same latest-value shape and same ALARM/OK/IDLE/NO_DATA CASE logic as ims-ldi-operator-andon.json panel id 1000, copied verbatim. Node 2 = LDI-02 (fixed literal, not templated). */\nSELECT\n  v.eqp_id AS eqp_id_2,\n  CASE\n    WHEN EXISTS (\n      SELECT 1 FROM public.ldi_alarm_log a\n      JOIN public.ldi_alarm_ms_code m ON a.errorcode::TEXT = m.alarm_code::TEXT\n      WHERE a.equipmentid = v.eqp_id AND m.severity IN ('Critical', 'Major')\n        AND a.logdate > NOW() - INTERVAL '5 minutes'\n    ) THEN 3\n    WHEN NOT v.has_data OR v.is_stale THEN 0\n    WHEN v.state THEN 2\n    ELSE 1\n  END AS state_2,\n  v.board_no AS board_2,\n  v.total_board AS total_board_2\nFROM public.v_ldi_machine_latest_full v\nWHERE v.eqp_id = 'LDI-02'\nLIMIT 1"
        }
      ],
