      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [],
        "enablePagination": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "WITH latest_status AS (\n  SELECT DISTINCT ON (equipment_id) equipment_id, event_type, event_code, event_message, event_time, id\n  FROM public.machine_event WHERE message_type='status'\n  ORDER BY equipment_id, event_time DESC, id DESC\n), latest_program AS (\n  SELECT DISTINCT ON (equipment_id) equipment_id, event_time, event_message\n  FROM public.machine_event WHERE event_type='PROGRAM_LOAD'\n  ORDER BY equipment_id, event_time DESC, id DESC\n), latest_error AS (\n  SELECT DISTINCT ON (equipment_id) equipment_id, event_time, event_code, event_message\n  FROM public.machine_event WHERE message_type='alarm' AND level='E'\n  ORDER BY equipment_id, event_time DESC, id DESC\n)\nSELECT s.equipment_id AS \"Machine ID\",\n       CASE WHEN s.event_type='RUN' THEN 4 WHEN s.event_type='STOP' THEN 3 ELSE 5 END AS \"State\",\n       s.event_time AS \"Status Time\",\n       ROUND(GREATEST(EXTRACT(EPOCH FROM (NOW()-s.event_time)),0)::NUMERIC,0) AS \"Age (s)\",\n       s.event_code AS \"Code\", s.event_message AS \"Current Evidence\",\n       CASE WHEN s.event_message ~* 'Run Hits\\s*:' THEN (regexp_match(s.event_message,'Run Hits\\s*:\\s*([0-9]+)','i'))[1]::INTEGER END AS \"Run Hits\",\n       p.event_message AS \"Latest Program\", e.event_code AS \"Last Error\", e.event_time AS \"Error Time\"\nFROM latest_status s\nLEFT JOIN latest_program p USING (equipment_id)\nLEFT JOIN latest_error e USING (equipment_id)\nWHERE (${status_filter:sqlstring}='All' OR s.event_type=${status_filter:sqlstring})\n  AND (${program_search:sqlstring}='' OR COALESCE(p.event_message,'') ILIKE '%' || ${program_search:sqlstring} || '%')\nORDER BY s.equipment_id",
          "format": "table"
        }
      ]
    }
  ],
