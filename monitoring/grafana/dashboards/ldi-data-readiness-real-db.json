    {
      "id": 8,
      "title": "Machine Data Coverage Matrix",
      "description": "Real row counts and field coverage per selected machine.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH alarm_counts AS (\n  SELECT equipmentid, COUNT(*) AS alarm_rows, MAX(logdate) AS last_alarm\n  FROM public.ldi_alarm_log\n  GROUP BY equipmentid\n)\nSELECT\n  d.eqp_id AS \"Machine\",\n  MIN(d.factory) AS \"Factory\",\n  MIN(d.process) AS \"Process\",\n  COUNT(*) AS \"Telemetry Rows\",\n  MAX(d.\"time\") AS \"Latest Telemetry\",\n  ROUND(100.0 * COUNT(d.pe_1) / COUNT(*), 1) AS \"PE %\",\n  ROUND(100.0 * COUNT(d.je_1) / COUNT(*), 1) AS \"JE1-3 %\",\n  ROUND(100.0 * COUNT(d.je_4) / COUNT(*), 1) AS \"JE4 %\",\n  COALESCE(MAX(a.alarm_rows), 0) AS \"Alarm Rows\",\n  MAX(a.last_alarm) AS \"Latest Alarm\"\nFROM public.ldi_data d\nLEFT JOIN alarm_counts a ON a.equipmentid = d.eqp_id\nWHERE d.factory IN (${factory:sqlstring})\n  AND d.eqp_id IN (${machine_id:sqlstring})\nGROUP BY d.eqp_id\nORDER BY d.eqp_id;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": []
      },
      "transparent": true
    },
    {
      "id": 9,
      "title": "Machine ID Mapping Gaps (Global)",
      "description": "Global comparison of machine identifiers in telemetry and alarm sources. This intentionally ignores dashboard filters so unmatched IDs stay visible.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH telemetry AS (\n  SELECT DISTINCT eqp_id FROM public.ldi_data\n), alarms AS (\n  SELECT DISTINCT equipmentid AS eqp_id FROM public.ldi_alarm_log\n), ids AS (\n  SELECT eqp_id FROM telemetry\n  UNION\n  SELECT eqp_id FROM alarms\n)\nSELECT\n  i.eqp_id AS \"Machine ID\",\n  (t.eqp_id IS NOT NULL) AS \"In Telemetry\",\n  (a.eqp_id IS NOT NULL) AS \"In Alarm\",\n  CASE\n    WHEN t.eqp_id IS NOT NULL AND a.eqp_id IS NOT NULL THEN 'MATCHED'\n    WHEN t.eqp_id IS NULL THEN 'ALARM ONLY'\n    ELSE 'TELEMETRY ONLY'\n  END AS \"Mapping Status\"\nFROM ids i\nLEFT JOIN telemetry t USING (eqp_id)\nLEFT JOIN alarms a USING (eqp_id)\nORDER BY \"Mapping Status\", i.eqp_id;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": []
      },
      "transparent": true
    },
    {
      "id": 10,
      "title": "Alarm Code Mapping Gaps (Global)",
      "description": "Every distinct alarm code from the real log and whether it resolves against the supplied alarm master.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  a.errorcode::TEXT AS \"Alarm Code\",\n  COUNT(*) AS \"Rows\",\n  CASE WHEN m.alarm_code IS NULL THEN 'UNMAPPED' ELSE 'MATCHED' END AS \"Mapping\",\n  COALESCE(m.alarm_msg, '') AS \"Message\",\n  COALESCE(m.alarm_type, '') AS \"Severity\"\nFROM public.ldi_alarm_log a\nLEFT JOIN public.ldi_alarm_ms_code m ON a.errorcode::TEXT = m.alarm_code::TEXT\nGROUP BY a.errorcode, m.alarm_code, m.alarm_msg, m.alarm_type\nORDER BY \"Rows\" DESC;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": []
      },
      "transparent": true
    },
    {
      "id": 11,
      "title": "Board Event Data Quality",
      "description": "Shows why telemetry rows cannot yet be treated as guaranteed board-completion events: board_id is missing and some MO + board_no keys repeat.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  eqp_id AS \"Machine\",\n  COUNT(*) AS \"Telemetry Rows\",\n  COUNT(DISTINCT (mo, board_no)) AS \"Unique MO + Board No\",\n  COUNT(*) - COUNT(DISTINCT (mo, board_no)) AS \"Duplicate Board Keys\",\n  ROUND(100.0 * COUNT(board_id) / COUNT(*), 1) AS \"Board ID %\",\n  COUNT(DISTINCT mo) AS \"Distinct MO\",\n  MIN(board_no) AS \"Min Board No\",\n  MAX(board_no) AS \"Max Board No\"\nFROM public.ldi_data\nWHERE factory IN (${factory:sqlstring})\n  AND eqp_id IN (${machine_id:sqlstring})\nGROUP BY eqp_id\nORDER BY \"Duplicate Board Keys\" DESC, eqp_id;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
