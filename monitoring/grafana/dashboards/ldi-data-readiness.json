{
  "uid": "ldi-data-readiness",
  "title": "IMS LDI — Data Readiness",
  "description": "5th LDI dashboard. Answers 'can I trust the SPC/yield numbers on the other 4 dashboards right now?' — machine reporting freshness, sensor null-rates, unmapped alarm coverage, ingestion throughput.",
  "tags": [
    "ims",
    "ldi",
    "data-quality",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": true,
  "style": "dark",
  "graphTooltip": 2,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Machines Reporting (Last 5m)",
      "type": "stat",
      "datasource": {
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#EF4444",
                "value": null
              },
              {
                "color": "#22C55E",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 48,
          "titleSize": 14
        },
        "noValue": "-"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "SELECT COUNT(DISTINCT eqp_id) AS value FROM public.ldi_data WHERE time >= NOW() - INTERVAL '5 minutes'",
          "format": "table"
        }
      ],
      "transparent": true,
      "description": "Distinct machines that have written at least one row of telemetry in the last 5 minutes."
    },
    {
      "id": 2,
      "title": "Fleet Data Completeness % (24h)",
      "type": "stat",
      "datasource": {
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#EF4444",
                "value": null
              },
              {
                "color": "#FACC15",
                "value": 80
              },
              {
                "color": "#22C55E",
                "value": 95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 48,
          "titleSize": 14
        },
        "noValue": "-"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "SELECT ROUND(COUNT(DISTINCT eqp_id) FILTER (WHERE time >= NOW() - INTERVAL '5 minutes') * 100.0 / NULLIF(COUNT(DISTINCT eqp_id), 0), 1) AS value FROM public.ldi_data WHERE time >= NOW() - INTERVAL '24 hours'",
          "format": "table"
        }
      ],
      "transparent": true,
      "description": "Of the machines that have reported at all in the last 24h, the percentage still reporting in the last 5 minutes."
    },
    {
      "id": 3,
      "title": "Unmapped Alarm Rate % (24h)",
      "type": "stat",
      "datasource": {
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22C55E",
                "value": null
              },
              {
                "color": "#FACC15",
                "value": 5
              },
              {
                "color": "#EF4444",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 48,
          "titleSize": 14
        },
        "noValue": "-"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "SELECT ROUND(COUNT(*) FILTER (WHERE m.alarm_code IS NULL) * 100.0 / NULLIF(COUNT(*), 0), 1) AS value FROM public.ldi_alarm_log a LEFT JOIN public.ldi_alarm_ms_code m ON a.errorcode::TEXT = m.alarm_code::TEXT WHERE a.logdate >= NOW() - INTERVAL '24 hours'",
          "format": "table"
        }
      ],
      "transparent": true,
      "description": "Percentage of alarm_log rows in the last 24h whose errorcode has no match in ldi_alarm_ms_code — these fall back to the COALESCE(...,'UNMAPPED') severity on the other LDI dashboards."
    },
    {
      "id": 4,
      "title": "Machine Last-Seen",
      "type": "table",
      "datasource": {
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "LIVE": {
                        "color": "#22C55E",
                        "text": "LIVE"
                      },
                      "DELAYED": {
                        "color": "#FACC15",
                        "text": "DELAYED"
                      },
                      "STALE": {
                        "color": "#EF4444",
                        "text": "STALE"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last Seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Seconds Stale",
            "desc": true
          }
        ],
        "rowHeight": 0.7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "SELECT eqp_id AS \"Machine\", MAX(time) AS \"Last Seen\", ROUND(EXTRACT(EPOCH FROM (NOW() - MAX(time)))::NUMERIC, 0) AS \"Seconds Stale\", CASE WHEN MAX(time) >= NOW() - INTERVAL '2 minutes' THEN 'LIVE' WHEN MAX(time) >= NOW() - INTERVAL '10 minutes' THEN 'DELAYED' ELSE 'STALE' END AS \"Status\" FROM public.ldi_data WHERE time >= NOW() - INTERVAL '24 hours' GROUP BY eqp_id ORDER BY MAX(time) ASC LIMIT 50",
          "format": "table"
        }
      ],
      "transparent": true,
      "description": "Per-machine last telemetry timestamp and staleness classification, bounded to machines seen in the last 24h."
    },
    {
      "id": 5,
      "title": "Sensor Null-Rate by Machine",
      "type": "table",
      "datasource": {
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Machine",
            "desc": false
          }
        ],
        "rowHeight": 0.7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "SELECT eqp_id AS \"Machine\", ROUND(COUNT(*) FILTER (WHERE temperature IS NULL) * 100.0 / NULLIF(COUNT(*), 0), 1) AS \"Temp Null %\", ROUND(COUNT(*) FILTER (WHERE humidity IS NULL) * 100.0 / NULLIF(COUNT(*), 0), 1) AS \"Humidity Null %\", ROUND(COUNT(*) FILTER (WHERE pe_1 IS NULL) * 100.0 / NULLIF(COUNT(*), 0), 1) AS \"PE Null %\", ROUND(COUNT(*) FILTER (WHERE je_1 IS NULL) * 100.0 / NULLIF(COUNT(*), 0), 1) AS \"JE Null %\" FROM public.ldi_data WHERE $__timeFilter(time) GROUP BY eqp_id ORDER BY eqp_id LIMIT 50",
          "format": "table"
        }
      ],
      "transparent": true,
      "description": "Percentage of NULL readings per key sensor column, per machine, over the dashboard time range — high null-rate flags a dead sensor or wiring fault before it corrupts SPC/Cpk numbers."
    },
    {
      "id": 6,
      "title": "Ingestion Row Count per Minute",
      "type": "timeseries",
      "datasource": {
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "pointSize": 4,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3B82F6"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        },
        "connectNullPoints": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, COUNT(*)::NUMERIC AS value FROM public.ldi_data WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "legendFormat": "rows/min"
        }
      ],
      "transparent": true,
      "description": "Raw ldi_data insert throughput — a sustained drop to zero means the ingestion pipeline stalled, not that the fleet actually stopped producing."
    }
  ],
  "links": [
    {
      "title": "Apex Circuit Fleet Command Center",
