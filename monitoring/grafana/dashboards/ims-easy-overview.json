{
  "description": "The easiest way to see the whole LDI fleet at once: no template variables to set, no filters to configure, just open it. Built entirely from this repo's shared views/functions (v_ldi_machine_latest_full, v_ldi_alarm_context, f_ldi_yield_pct, v_machine_spc_fleet) -- every number here traces back to one governed source, not a one-off query. For deeper drill-down (per-machine SPC ranking, board traceability, event timelines), use the Manufacturing, Engineering Analytics, or Machine Snapshot dashboards instead.",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "liveNow": true,
  "graphTooltip": 0,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 9000,
      "type": "row",
      "title": "◈ FLEET AT A GLANCE",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "◉ Fleet Availability",
      "type": "stat",
      "datasource": {
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#EF4444",
                "value": null
              },
              {
                "color": "#F59E0B",
                "value": 70
              },
              {
                "color": "#22C55E",
                "value": 90
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "#64748B",
                  "text": "NO_DATA",
                  "index": 0
                }
              }
            }
          ],
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "noValue": "NO_DATA",
        "textMode": "auto",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "timescaledb"
          },
          "rawSql": "SELECT ROUND((COUNT(*) FILTER (WHERE state = true) * 100.0 / NULLIF(COUNT(*), 0))::NUMERIC, 0) AS value\nFROM public.v_ldi_machine_latest_full",
          "format": "table"
        }
      ],
      "description": "Percent of the registered LDI fleet currently running (public.v_ldi_machine_latest_full, migration 052 -- the shared latest-snapshot view)."
    },
    {
      "id": 2,
      "title": "◉ Machines Running",
