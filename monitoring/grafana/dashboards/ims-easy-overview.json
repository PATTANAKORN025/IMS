          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#EF4444",
                "value": null
              },
              {
                "color": "#F59E0B",
                "value": 80
              },
              {
                "color": "#22C55E",
                "value": 95
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
