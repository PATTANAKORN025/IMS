t: 8px;\n  box-shadow: 0 0 8px #22C55E;\n}\n\n.ims-status-text {\n  font-size: 12px;\n  color: #94A3B8;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n</style>\n\n<div class=\"ims-brand-container\">\n  <div>\n    <h1 class=\"ims-logo-text\">IMS</h1>\n    <div class=\"ims-logo-sub\">Industrial Monitoring System</div>\n  </div>\n  <div class=\"ims-dash-title\">\n    IMS Ingestion Latency\n  </div>\n  <div>\n    <span class=\"ims-status-dot\"></span><span class=\"ims-status-text\">System Optimal</span>\n  </div>\n</div>",
