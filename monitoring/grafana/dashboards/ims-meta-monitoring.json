    {
      "type": "timeseries",
      "title": "Inserts / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 16,
        "w": 8,
        "x": 0,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 5,
            "showGridLines": false,
            "axisBorderShow": false,
            "gradientMode": "opacity"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "/.*/"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "rate(ims_pipeline_inserts_total[5m])",
          "legendFormat": "Inserts/sec",
          "refId": "A"
        }
      ],
      "description": "Rate of successful database inserts per second from the pipeline.",
      "options": {
        "connectNullPoints": true,
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "transparent": true
    },
    {
