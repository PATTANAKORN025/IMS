      },
      "gridPos": {
        "h": 16,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "device_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "CLOSED",
                        "color": "#10B981"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "OPEN",
                        "color": "#EF4444"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "2": {
                        "text": "HALF-OPEN",
                        "color": "#3B82F6"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "/.*/"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "/.*/"
            },
            "properties": [
              {
                "id": "custom.fontFamily",
                "value": "'Roboto Mono', monospace"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "ims_circuit_breaker_state",
          "legendFormat": "{{device_id}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "device_id": "Device",
              "Value": "State"
            }
          }
        }
      ],
      "description": "Per-device circuit breaker state table (0=CLOSED, 1=OPEN, 2=HALF_OPEN).",
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "noValue": "-"
      },
      "transparent": true
