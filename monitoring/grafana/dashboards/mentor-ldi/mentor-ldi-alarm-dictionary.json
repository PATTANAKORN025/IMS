          {
            "matcher": {
              "id": "byName",
              "options": "Link Basis"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "causal": {
                        "color": "#22C55E",
                        "text": "causal"
                      },
                      "nearest": {
                        "color": "#64748B",
                        "text": "nearest"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "mentor-ldi-readonly"
          },
          "rawSql": "/* Mentor schema has no telemetry relation ID/link-basis columns. */\nSELECT a.logdate AS \"Time\",\n       a.equipmentid AS \"Machine\",\n       a.logid AS \"Alarm Event ID\",\n       NULL::text AS \"Telemetry Event ID\",\n       'unlinked (not present in mentor schema)'::text AS \"Link Basis\"\nFROM public.ldi_alarm_log a\nWHERE a.errorcode = ${alarm_code:sqlstring}\nORDER BY a.logdate DESC\nLIMIT 20;",
          "format": "table"
        }
      ],
      "description": "The most recent 20 times this alarm code actually fired, fleet-wide -- for pattern spotting (which machines, how often, causal vs. nearest telemetry link)."
    }
