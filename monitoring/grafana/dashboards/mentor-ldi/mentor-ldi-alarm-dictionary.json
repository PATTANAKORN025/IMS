      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "mentor-ldi-readonly"
          },
          "rawSql": "/* Mentor schema: definition fields are limited to the five vendor columns present. */\nSELECT alarm_id AS \"Alarm Code\",\n       alarm_type AS \"Alarm Type\",\n       alarm_msg AS \"Message\",\n       alarm_detail AS \"Detail\",\n       CASE upper(COALESCE(alarm_type, ''))\n         WHEN 'A' THEN 'Major'\n         WHEN 'W' THEN 'Warning'\n         WHEN 'E' THEN 'Error'\n         ELSE 'Unclassified'\n       END AS \"Derived Severity\",\n       'Not available in mentor master'::text AS \"Cause\",\n       'Not available in mentor master'::text AS \"Impact\",\n       'Not available in mentor master'::text AS \"Recovery Action\",\n       'Not available in mentor master'::text AS \"SOP / Work Instruction\"\nFROM public.ldi_alarm_ms_code\nWHERE alarm_id = ${alarm_code:sqlstring} OR alarm_code = ${alarm_code:sqlstring}\nLIMIT 1;",
          "format": "table"
        }
      ],
      "description": "The full vendor Alarm Master definition for this code -- the same row every occurrence of this alarm type shares. No row here means the code isn't in the currently loaded catalog (check data mode: mock vs. real -- see docs/architecture/ALARM_SEVERITY_GUIDE.md)."
    },
    {
      "id": 3,
      "title": "◈ Recent Occurrences (Live Data)",
      "type": "table",
      "datasource": {
