                "value": "What this means operationally right now -- blocked, delayed, or a quality risk. See ALARM_DETAIL_STYLE_GUIDE.md §6."
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Recovery Action"
            },
            "properties": [
              {
                "id": "description",
                "value": "What the operator/technician should do next."
              }
            ]
          },
