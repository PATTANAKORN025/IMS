            "properties": [
              {
                "id": "description",
                "value": "Link to a real Standard Operating Procedure or Work Instruction document, when one exists. Intentionally not populated yet -- see ALARM_DETAIL_STYLE_GUIDE.md §7; this is a genuine content gap, not a broken field."
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
