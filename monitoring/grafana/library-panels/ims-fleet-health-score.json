{
  "uid": "ims-lib-fleet-health-score",
  "name": "Fleet Health Score",
  "kind": 1,
  "model": {
    "title": "◉ Fleet Health Score",
    "type": "stat",
    "description": "Composite fleet health score (0-100%) from v_fleet_health view.",
    "datasource": {
      "uid": "timescaledb"
    },
    "libraryPanel": {
      "uid": "ims-lib-fleet-health-score",
      "name": "Fleet Health Score"
    },
    "fieldConfig": {
      "defaults": {
        "unit": "percent",
        "min": 0,
        "max": 100,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "#EF4444",
              "value": null
            },
            {
              "color": "#F59E0B",
              "value": 70
            },
            {
              "color": "#22C55E",
              "value": 90
            }
          ]
        },
        "color": {
          "mode": "fixed",
          "fixedColor": "#00F2FE"
        },
        "custom": {
          "gradientMode": "opacity",
          "lineInterpolation": "smooth",
          "fillOpacity": 15,
          "lineWidth": 2
        },
        "decimals": 2,
        "mappings": [
          {
            "type": "special",
            "options": {
              "match": "null+nan",
              "result": {
                "text": "NO_DATA",
                "color": "#64748B"
              }
            }
          }
        ],
        "noValue": "NO_DATA"
      },
      "overrides": [
        {
          "matcher": {
            "id": "byName",
            "options": "/.*/"
          },
          "properties": [
            {
              "id": "decimals",
              "value": 2
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "/.*/"
          },
          "properties": [
            {
              "id": "custom.fontFamily",
              "value": "'Roboto Mono', monospace"
            }
          ]
        }
      ]
    },
    "options": {
      "colorMode": "value",
      "graphMode": "area",
      "justifyMode": "center",
      "reduceOptions": {
        "calcs": [
          "lastNotNull"
        ],
        "values": false
      },
      "noValue": "NO_DATA",
      "textMode": "value",
      "text": {
        "valueSize": 56,
        "titleSize": 18
      }
    },
    "targets": [
      {
        "refId": "A",
        "datasource": {
          "uid": "timescaledb"
        },
        "format": "table",
        "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: full dataset scope */\nSELECT value FROM public.v_fleet_score"
      }
    ],
    "links": [
      {
        "title": "Drill-down -> Engineering",
        "url": "/d/ims-engineering?var-machine_id=${machine_id}&from=${__from}&to=${__to}",
        "targetBlank": true
      }
    ]
  }
}
